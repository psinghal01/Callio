# Copy to .env and fill in values:
#   cp .env.example .env

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Set true only when running without Postgres (local quick start).
USE_SQLITE=false

# Postgres — used by both Django and the official Postgres image.
# Inside Docker Compose the host MUST be "db" (the service name).
# On your machine (no Compose) use "localhost" or set USE_SQLITE=true.
POSTGRES_DB=callio
POSTGRES_USER=callio
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_SSL=false
DB_CONN_MAX_AGE=60

# Optional: overrides POSTGRES_* when set.
# DATABASE_URL=postgres://callio:change-me@db:5432/callio

# Redis — room state + Channels. Inside Compose the host MUST be "redis".
REDIS_URL=redis://redis:6379/0
ROOM_MAX_PARTICIPANTS=20
ROOM_TTL_SECONDS=86400
# Kept for compatibility. Empty rooms use ROOM_TTL_SECONDS so the link stays valid.
ROOM_EMPTY_TTL_SECONDS=86400
ROOM_CODE_LENGTH=6

# ICE — local Docker coturn (STUN + TURN). Browsers must reach this host, not the
# Compose service name. Use 127.0.0.1 on this machine; set ICE_HOST to your LAN
# IP for a phone on the same Wi-Fi. ICE_ENABLED=false disables ICE servers.
ICE_ENABLED=true
ICE_STUN_URLS=stun:127.0.0.1:3478
ICE_TURN_URLS=turn:127.0.0.1:3478
ICE_TURN_USERNAME=callio
ICE_TURN_PASSWORD=callio-turn
ICE_HOST=
# IP coturn advertises in ICE candidates. Must be reachable by the browser.
# 127.0.0.1 for two tabs on this machine. Your LAN IP for a phone on the same Wi-Fi.
ICE_EXTERNAL_IP=127.0.0.1
TURN_REALM=callio.local

# Timezone
TZ=UTC

# Reverse-proxy / HTTPS (leave defaults for local Docker)
USE_X_FORWARDED_HOST=true
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
