# Copy to .env and fill in values:
#   cp .env.example .env

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Set true only when running without Postgres (local quick start).
USE_SQLITE=false

# Postgres — used by both Django and the official Postgres image.
# Inside Docker Compose the host MUST be "db" (the service name).
# On your machine (no Compose) use "localhost" or set USE_SQLITE=true.
POSTGRES_DB=callio
POSTGRES_USER=callio
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_SSL=false
DB_CONN_MAX_AGE=60

# Optional: overrides POSTGRES_* when set.
# DATABASE_URL=postgres://callio:change-me@db:5432/callio

# Timezone
TZ=UTC

# Reverse-proxy / HTTPS (leave defaults for local Docker)
USE_X_FORWARDED_HOST=true
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
